# =============================================================================
# 考研英语智能学习平台 —— 环境变量配置文件
# =============================================================================

# 应用运行环境 (development / production)
APP_ENV=production

# 绑定的主机地址与端口
HOST=0.0.0.0
PORT=8000

# 数据库连接串 (默认使用 SQLite 本地单文件数据库，企业部署可替换为 PostgreSQL)
DATABASE_URL=sqlite:///./backend/kaoyan_learning.db

# 静态资源与前端目录相对路径
FRONTEND_DIR=./frontend

# 密钥 (生产环境建议使用 openssl rand -hex 32 生成高强度随机串)
SECRET_KEY=change_this_to_a_secure_random_key_in_production

# 可选：大型语言模型 API 密钥 (用于主观题翻译、作文的高级语义扩展反馈，不填则默认使用确定性评分规则引擎)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
